# DARK HOST Termux Theme
# Installed by dark-host-termux

clear

printf '\033[1;36m'
cat <<'EOF'
╭──────────────────────────────╮
│        D A R K   H O S T     │
│                              │
│   SYSTEM  : ONLINE           │
│   SHELL   : BASH             │
│   TERMUX  : READY            │
╰──────────────────────────────╯
EOF
printf '\033[0m'

# Useful aliases
alias cls='clear'
alias ll='ls -lah'
alias la='ls -A'
alias c='clear'

# DARK HOST prompt
PS1='\[\e[38;5;244m\]┌─[\A]──\[\e[38;5;39m\][dark]\[\e[38;5;244m\]──[\w]\n└─► \[\e[0m\]'
